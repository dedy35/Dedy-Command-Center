generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SensitivityLevel {
  public
  internal
  private
  confidential
}

enum SourceType {
  text
  photo
  pdf
  url
  email
  chat
  manual
}

enum AiOutputStatus {
  draft
  approved
  rejected
  superseded
}

enum ApprovalActionType {
  copy
  send
  update
  export
  delete
  submit
}

enum ApprovalStatus {
  pending
  approved
  rejected
}

enum AuditActor {
  user
  system
  ai
}

enum TicketStatus {
  new
  analyzing
  waiting
  implemented
  released
}

enum RiskLevel {
  low
  medium
  high
  critical
}

enum TicketNoteType {
  analysis
  test
  senior_feedback
  redmine_comment
  internal_note
}

enum WorkLogCategory {
  coding
  analysis
  meeting
  testing
  documentation
  support
  planning
}

model User {
  id          String   @id @default(uuid()) @db.Uuid
  displayName String   @map("display_name")
  email       String?  @unique
  timezone    String   @default("Asia/Tokyo")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([createdAt], map: "idx_users_created")
  @@map("users")
}

model LifeEvent {
  id          String           @id @default(uuid()) @db.Uuid
  eventDate   DateTime         @map("event_date") @db.Date
  module      String
  title       String
  summary     String?
  sourceId    String?          @map("source_id") @db.Uuid
  sensitivity SensitivityLevel @default(internal)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  source      Source?           @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  ticketLinks TicketLifeEvent[]

  @@index([eventDate], map: "idx_life_events_date")
  @@index([module], map: "idx_life_events_module")
  @@map("life_events")
}

model Source {
  id          String           @id @default(uuid()) @db.Uuid
  sourceType  SourceType       @map("source_type")
  contentText String?          @map("content_text")
  fileId      String?          @map("file_id") @db.Uuid
  origin      String?
  sensitivity SensitivityLevel @default(private)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  file       Attachment? @relation(fields: [fileId], references: [id], onDelete: SetNull)
  lifeEvents LifeEvent[]
  aiOutputs  AiOutput[]
  tickets    Ticket[]

  @@index([sourceType], map: "idx_source_type")
  @@index([createdAt], map: "idx_sources_created")
  @@map("sources")
}

model Attachment {
  id        String   @id @default(uuid()) @db.Uuid
  filePath  String   @map("file_path")
  fileName  String   @map("file_name")
  mimeType  String   @map("mime_type")
  sizeBytes BigInt   @map("size_bytes")
  sha256    String?  @unique
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  sources     Source[]
  ticketNotes TicketNote[]

  @@map("attachments")
}

model AiOutput {
  id         String         @id @default(uuid()) @db.Uuid
  sourceId   String?        @map("source_id") @db.Uuid
  module     String
  promptKey  String         @map("prompt_key")
  model      String?
  outputType String         @map("output_type")
  content    String
  status     AiOutputStatus @default(draft)
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  source       Source?       @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  approvals    Approval[]
  achievements Achievement[]

  @@index([sourceId], map: "idx_ai_source")
  @@index([module], map: "idx_ai_module")
  @@index([outputType], map: "idx_output_type")
  @@index([status], map: "idx_ai_status")
  @@map("ai_outputs")
}

model Approval {
  id           String             @id @default(uuid()) @db.Uuid
  aiOutputId   String             @map("ai_output_id") @db.Uuid
  actionType   ApprovalActionType @map("action_type")
  status       ApprovalStatus     @default(pending)
  approvedAt   DateTime?          @map("approved_at") @db.Timestamptz(6)
  approvalNote String?            @map("approval_note")
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)

  aiOutput AiOutput @relation(fields: [aiOutputId], references: [id], onDelete: Cascade)

  @@index([aiOutputId], map: "idx_approval_output")
  @@index([status], map: "idx_approval_status")
  @@map("approvals")
}

model AuditLog {
  id          String     @id @default(uuid()) @db.Uuid
  actor       AuditActor
  action      String
  entityTable String     @map("entity_table")
  entityId    String?    @map("entity_id") @db.Uuid
  beforeJson  Json?      @map("before_json")
  afterJson   Json?      @map("after_json")
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([actor], map: "idx_audit_actor")
  @@index([action], map: "idx_audit_action")
  @@index([entityTable, entityId], map: "idx_audit_entity")
  @@index([createdAt], map: "idx_audit_created")
  @@map("audit_logs")
}

model Tag {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  color     String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  entityTags EntityTag[]

  @@map("tags")
}

model EntityTag {
  id          String   @id @default(uuid()) @db.Uuid
  tagId       String   @map("tag_id") @db.Uuid
  entityTable String   @map("entity_table")
  entityId    String   @map("entity_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tag Tag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([tagId, entityTable, entityId], map: "uq_entity_tag")
  @@index([entityTable, entityId], map: "idx_entity_tags_entity")
  @@map("entity_tags")
}

model Ticket {
  id         String       @id @default(uuid()) @db.Uuid
  ticketNo   String?      @map("ticket_no")
  systemName String?      @map("system_name")
  title      String
  status     TicketStatus @default(new)
  riskLevel  RiskLevel    @default(medium) @map("risk_level")
  sourceId   String?      @map("source_id") @db.Uuid
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  source     Source?           @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  notes      TicketNote[]
  lifeEvents TicketLifeEvent[]
  workLogs   WorkLog[]

  @@index([ticketNo], map: "idx_ticket_no")
  @@index([status], map: "idx_ticket_status")
  @@index([riskLevel], map: "idx_ticket_risk")
  @@index([createdAt], map: "idx_tickets_created")
  @@map("tickets")
}

model TicketNote {
  id                     String         @id @default(uuid()) @db.Uuid
  ticketId               String         @map("ticket_id") @db.Uuid
  noteType               TicketNoteType @default(analysis) @map("note_type")
  content                String
  screenshotAttachmentId String?        @map("screenshot_attachment_id") @db.Uuid
  createdAt              DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  ticket               Ticket      @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  screenshotAttachment Attachment? @relation(fields: [screenshotAttachmentId], references: [id], onDelete: SetNull)

  @@index([ticketId], map: "idx_ticket_notes_ticket")
  @@index([createdAt], map: "idx_ticket_notes_created")
  @@map("ticket_notes")
}

model TicketLifeEvent {
  id          String   @id @default(uuid()) @db.Uuid
  ticketId    String   @map("ticket_id") @db.Uuid
  lifeEventId String   @map("life_event_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  ticket    Ticket    @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  lifeEvent LifeEvent @relation(fields: [lifeEventId], references: [id], onDelete: Cascade)

  @@unique([ticketId, lifeEventId], map: "uq_ticket_life_event")
  @@index([ticketId], map: "idx_ticket_life_events_ticket")
  @@index([lifeEventId], map: "idx_ticket_life_events_life_event")
  @@map("ticket_life_events")
}

model WorkLog {
  id              String          @id @default(uuid()) @db.Uuid
  workDate        DateTime        @map("work_date") @db.Date
  category        WorkLogCategory @default(coding)
  description     String
  impact          String?
  relatedTicketId String?         @map("related_ticket_id") @db.Uuid
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  relatedTicket Ticket?       @relation(fields: [relatedTicketId], references: [id], onDelete: SetNull)
  achievements  Achievement[]

  @@index([workDate], map: "idx_work_logs_date")
  @@index([category], map: "idx_work_logs_category")
  @@index([relatedTicketId], map: "idx_work_logs_ticket")
  @@index([createdAt], map: "idx_work_logs_created")
  @@map("work_logs")
}

model Achievement {
  id               String   @id @default(uuid()) @db.Uuid
  workLogId        String   @map("work_log_id") @db.Uuid
  sourceAiOutputId String?  @map("source_ai_output_id") @db.Uuid
  starSituation    String?  @map("star_situation")
  starTask         String?  @map("star_task")
  starAction       String?  @map("star_action")
  starResult       String?  @map("star_result")
  cvBulletEn       String?  @map("cv_bullet_en")
  cvBulletId       String?  @map("cv_bullet_id")
  impactQuestions  String[] @map("impact_questions")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  workLog        WorkLog   @relation(fields: [workLogId], references: [id], onDelete: Cascade)
  sourceAiOutput AiOutput? @relation(fields: [sourceAiOutputId], references: [id], onDelete: SetNull)

  @@index([workLogId], map: "idx_achievements_work_log")
  @@index([sourceAiOutputId], map: "idx_achievements_ai_output")
  @@index([createdAt], map: "idx_achievements_created")
  @@map("achievements")
}
